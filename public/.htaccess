<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # HTTP -> HTTPS (20.10.2026). Sertifika yenileme (ACME) yolu ve yerel geliştirme (localhost) hariç;
    # proxy arkasında döngü olmasın.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Yerel geliştirme (localhost) işaretle — HSTS SADECE canlıda gönderilsin (21.10.2026: localhost'ta
    # HSTS tarayıcıya önbelleğe alınıp geçerli sertifika olmadan https'e zorluyordu).
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ - [E=CANLI_HOST:1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# PWA (13.10.2026): manifest doğru türle sunulsun; service worker önbellekte
# takılı kalmasın (yeni sürüm hemen gelsin).
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache, max-age=0"
    </Files>
</IfModule>

# Güvenlik başlıkları (20.10.2026). HSTS kısa tutuldu (1 gün); sorun yoksa uzatılır.
# HSTS SADECE canlı hostlarda (21.10.2026) — localhost'ta tarayıcıya önbelleğe alınıp
# geçersiz yerel sertifikayla güvenlik hatasına yol açıyordu.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=86400" env=CANLI_HOST
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
